{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Mobile (Expo)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:mobile"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "Admin (Next.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:admin"],
      "port": 3001
    },
    {
      "name": "Shared (watch)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=packages/shared"],
      "port": 0
    }
  ]
}
