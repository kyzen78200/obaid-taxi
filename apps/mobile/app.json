{
  "expo": {
    "name": "Obaid Taxi",
    "slug": "obaid-taxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D4ED8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.obaidtaxi.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Obaid Taxi utilise votre position pour définir votre point de départ.",
        "NSLocationAlwaysUsageDescription": "Obaid Taxi utilise votre position pour définir votre point de départ.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D4ED8"
      },
      "package": "com.obaidtaxi.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "$GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1D4ED8"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "scheme": "obaid-taxi",
    "extra": {
      "eas": {
        "projectId": "b1e36c3f-5743-4fc7-b2f0-fd27f5c0ade1"
      },
      "router": {}
    },
    "owner": "zebreyn"
  }
}
